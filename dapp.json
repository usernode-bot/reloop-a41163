{
  "description": "Neighborhood app for giving, swapping and cheaply selling second-hand items so they stay in use",
  "secrets": [
    {
      "key": "ADMIN_SETUP_CODE",
      "description": "One-time setup code the neighborhood's first moderator enters on the Profile screen to claim the moderator role. Leave the value empty to disable moderator setup entirely.",
      "required": true,
      "private": true,
      "staging_default": "staging-demo-setup"
    }
  ],
  "tests": [
    {
      "name": "Home feed shows nearby items",
      "path": "/",
      "expectText": "Staging demo: Denim jacket"
    },
    {
      "name": "Home shows the type filters",
      "path": "/",
      "expectText": "Cheap"
    },
    {
      "name": "Post an Item form renders",
      "path": "/#/post",
      "expectText": "Pickup area"
    },
    {
      "name": "Item Detail offers a request",
      "path": "/#/item/900001",
      "expectText": "Request this item"
    },
    {
      "name": "Item Detail offers a report",
      "path": "/#/item/900001",
      "expectText": "Report this item"
    },
    {
      "name": "My Loops shows both tabs",
      "path": "/#/loops",
      "expectText": "My Requests"
    },
    {
      "name": "My Loops honest empty state",
      "path": "/#/loops",
      "expectText": "No items posted yet"
    },
    {
      "name": "Impact shows the estimate",
      "path": "/#/impact",
      "expectText": "Estimated kg of waste avoided"
    },
    {
      "name": "Profile shows the pickup area",
      "path": "/#/profile",
      "expectText": "Pickup area"
    },
    {
      "id": "community-browse",
      "name": "Community browse",
      "path": "/",
      "visual": true,
      "impact": ["public/**", "server.js"]
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "♻️"
  }
}
