{
  "description": "Give, swap and sell second-hand items with your neighbors",
  "secrets": [],
  "tests": [
    {
      "name": "Home shows the feed",
      "path": "/",
      "expectText": "Nearby items"
    },
    {
      "name": "Home shows a seeded item",
      "path": "/",
      "expectText": "Staging demo: Denim jacket"
    },
    {
      "name": "Item detail offers a request",
      "path": "/#/item/9000101",
      "expectText": "Request this item"
    },
    {
      "name": "Post an item form renders",
      "path": "/#/post",
      "expectText": "Post an item"
    },
    {
      "name": "My Loops renders with its tabs",
      "path": "/#/loops",
      "expectText": "My Loops"
    },
    {
      "name": "Impact shows the reuse figures",
      "path": "/#/impact",
      "expectText": "Items reused"
    },
    {
      "name": "Profile shows the pickup area setting",
      "path": "/#/profile",
      "expectText": "Pickup area"
    },
    {
      "id": "feed.browse",
      "name": "Browse the neighborhood feed",
      "path": "/",
      "expectText": "Nearby items",
      "visual": true,
      "impact": ["public/**", "server.js", "styles/**"]
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "♻️"
  }
}
