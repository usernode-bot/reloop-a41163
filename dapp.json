{
  "description": "Digital waste bank app for neighborhoods to track and manage recyclable waste",
  "secrets": [
    {
      "key": "ADMIN_SETUP_CODE",
      "description": "One-time setup code the neighborhood's first waste bank manager enters on the Profile screen to claim the manager role. Leave the value empty to disable manager setup entirely.",
      "required": true,
      "private": true,
      "staging_default": "staging-demo-setup"
    }
  ],
  "tests": [
    {
      "name": "Home renders the points card",
      "path": "/",
      "expectText": "Points"
    },
    {
      "name": "Home shows the neighborhood totals and leaderboard",
      "path": "/",
      "expectText": "Recycled by the neighborhood"
    },
    {
      "name": "Rewards catalog renders with stock",
      "path": "/#/rewards",
      "expectText": "Staging demo reward"
    },
    {
      "name": "Deposits shows the honest empty state",
      "path": "/#/deposits",
      "expectText": "No deposits yet"
    },
    {
      "name": "Prices list renders the seeded waste types",
      "path": "/#/prices",
      "expectText": "pts per kg"
    },
    {
      "name": "Profile renders",
      "path": "/#/profile",
      "expectText": "Profile"
    },
    {
      "name": "Home shows the next collection section",
      "path": "/",
      "expectText": "Next collection"
    },
    {
      "name": "Home shows the next collection time from a schedule",
      "path": "/?demo=1",
      "expectText": "08:00–10:00"
    },
    {
      "id": "resident-browse",
      "name": "Resident browse: home and rewards",
      "path": "/",
      "visual": true,
      "impact": ["public/**", "server.js"]
    }
  ],
  "icon": {
    "image": "brand/icon.png",
    "emoji": "♻️"
  }
}
